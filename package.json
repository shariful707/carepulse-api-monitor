    "check": "node --check src/server.js && node --check web/app.js",
    "demo": "node scripts/send_demo.js sample",
    "recover": "node scripts/send_demo.js recover"
  },
  "dependencies": {
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
