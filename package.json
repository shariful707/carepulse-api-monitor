{
  "name": "careguide-api-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Intelligent API Monitoring & Alert System - Care Guide technical assessment",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
