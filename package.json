{
  "name": "carepulse-api-monitor",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "API health monitoring with OpenAI and local Ollama explanations, SQLite incident history, and SMTP email reports.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "demo": "node scripts/send_demo.js sample",
    "recover": "node scripts/send_demo.js recover",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
