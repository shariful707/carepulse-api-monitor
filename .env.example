# All values optional; defaults support local demo.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/monitor.sqlite
SLOW_THRESHOLD_MS=2000
MAX_BATCH_SIZE=100
# AI_PROVIDER: gemini, openai, or none
AI_PROVIDER=none
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verify available models for your account. Current default confirmed in Google docs Oct 2026.
GEMINI_MODEL=gemini-3.8-flash
# Alternative OpenAI Chat Completions-compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional protection for remote deployments; not required locally
MONITOR_API_KEY=
