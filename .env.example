# Local server. No API keys or email credentials are required for a preview demo.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/monitor.sqlite
SETTINGS_PATH=./data/settings.json
SLOW_THRESHOLD_MS=2000
MAX_BATCH_SIZE=100

# none | openai | ollama | gemini. Saved dashboard settings override these initial values.
AI_PROVIDER=none
AI_TIMEOUT_MS=60000

# OpenAI credentials stay on the backend. Choose a model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Native Ollama API. Install a model first: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional retained Gemini integration. Set a model available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# off | preview | smtp. Preview saves reports locally and never sends email.
EMAIL_MODE=preview
EMAIL_TO=
EMAIL_FROM=carepulse@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# Optional protection for every POST endpoint. Browser users enter it in Settings.
# Read endpoints are not authenticated; keep this prototype on a trusted local machine.
MONITOR_API_KEY=
